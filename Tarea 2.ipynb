    "\n",
    "B = a1*A - a2*A**(2/3) - (a3*Z**2)/A**(1/3) - (a4*(A-2Z)**2)/A + a5/A**(1/2)\n",
    "\n",
    "print(\"La energía de enlace para el átomo es: \", B)"
